# Copy to backend/.env.server. Java properties: no export or surrounding quotes.
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
API_HOST=127.0.0.1
API_PORT=3001
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_SECURE_COOKIE=false
CHAT_TIMEOUT_MS=20000

# Paid API requests are paused by default, even when a key is present.
AI_CHAT_ENABLED=false
