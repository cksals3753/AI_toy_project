# Copy to .env.server (ignored by Git); read only by the Node server.
# OpenAI API key. Leave empty to keep AI chat unavailable while scripted play works.
OPENAI_API_KEY=
# Adapter name; defaults to openai.
AI_PROVIDER=
# Responses-compatible model; defaults to gpt-5.4-mini.
AI_MODEL=
# Defaults: host 127.0.0.1, port 3001.
API_HOST=
API_PORT=
# Comma-separated exact frontend origins. Defaults: localhost:5173 and 127.0.0.1:5173.
CHAT_ALLOWED_ORIGINS=
# Set true when serving the game over HTTPS.
CHAT_SECURE_COOKIE=
# Vite's server-side proxy target; defaults to http://127.0.0.1:3001.
# For dev override use the process environment, not a VITE_ key.
CHAT_API_TARGET=
