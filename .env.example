# AI secrets belong in backend/.env.server; see backend/.env.example.
# Optional Vite proxy target (set in the shell starting Vite):
# CHAT_API_TARGET=http://127.0.0.1:3001 npm run dev

# Explicit opt-in; leave false while paid API testing is paused.
VITE_AI_CHAT_ENABLED=false

# Chapter 1-6 renderer (legacy variable name). Set false for the 2D comparison.
VITE_FIRST_ROOM_3D=true
